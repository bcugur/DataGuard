# DataGuard — Environment Variables Template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
DATAGUARD_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Report output
# ---------------------------------------------------------------------------
# Directory where JSON reports will be saved (relative or absolute path)
DATAGUARD_REPORT_OUTPUT_DIR=reports

# ---------------------------------------------------------------------------
# Validation defaults
# ---------------------------------------------------------------------------
# Default threshold applied to rules that don't specify one (0.0 – 1.0)
DATAGUARD_DEFAULT_THRESHOLD=0.95
